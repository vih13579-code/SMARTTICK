<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Revenue Statistics | SMARTTICK</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/smarttick.css"></head><body class="admin-ops-page"><div class="dashboard-shell"><jsp:include page="SidebarDashboard.jsp"/><main class="dash-main"><div class="section-head"><div><h2>Revenue Statistics</h2><p class="section-sub">Revenue only counts delivered orders.</p></div></div><form class="filter-panel" method="get" action="${pageContext.request.contextPath}/RevenueStatisticServlet"><select class="form-select" name="timePeriod" onchange="this.form.submit()"><option value="day" ${time=='day'?'selected':''}>By Day</option><option value="month" ${time=='month'?'selected':''}>By Month</option><option value="year" ${time=='year'?'selected':''}>By Year</option></select></form><section class="panel"><h3>Revenue Summary</h3><table class="table"><thead><tr><th>Time</th><th>Orders</th><th>Products Sold</th><th>Revenue</th></tr></thead><tbody><c:forEach items="${revenueData}" var="r"><tr><td><c:choose><c:when test="${time=='day'}">${r.orderDate}</c:when><c:when test="${time=='year'}">${r.orderYear}</c:when><c:otherwise>${r.orderMonth}/${r.orderYear}</c:otherwise></c:choose></td><td>${r.totalOrder}</td><td>${r.totalProductsSold}</td><td><fmt:formatNumber value="${r.totalRevenue}" pattern="#,##0"/> VND</td></tr></c:forEach></tbody></table></section><div class="catalog-grid"><section class="panel"><h3>Men's Watches by Month</h3><table class="table"><tr><th>Month</th><th>Revenue</th></tr><c:forEach items="${listRevenueMen}" var="r"><tr><td>${r.month}</td><td><fmt:formatNumber value="${r.revenue}" pattern="#,##0"/> VND</td></tr></c:forEach></table></section><section class="panel"><h3>Women's Watches by Month</h3><table class="table"><tr><th>Month</th><th>Revenue</th></tr><c:forEach items="${listRevenueWomen}" var="r"><tr><td>${r.month}</td><td><fmt:formatNumber value="${r.revenue}" pattern="#,##0"/> VND</td></tr></c:forEach></table></section></div></main></div></body></html>

