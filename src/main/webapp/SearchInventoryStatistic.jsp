<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %><%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Inventory Statistics | SMARTTICK</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/smarttick.css"></head><body class="admin-ops-page"><div class="dashboard-shell"><jsp:include page="SidebarDashboard.jsp"/><main class="dash-main"><div class="section-head"><div><h2>Inventory Statistics</h2><p class="section-sub">Track watch quantities by model, category, and supplier.</p></div></div><form class="filter-panel" action="${pageContext.request.contextPath}/SearchInventoryServlet" method="get"><div class="inline-form"><input class="form-control" name="query" value="<c:out value='${searchQuery}'/>" placeholder="Name, model, brand, or supplier"><button class="btn btn-primary">Search</button></div></form><div class="catalog-grid"><section class="panel"><h3>Men's Watches</h3><table class="table"><tr><th>Model</th><th>Stock</th></tr><c:forEach items="${listInventoryMen}" var="i"><tr><td><c:out value="${i.modelName}"/></td><td>${i.stockQuantity}</td></tr></c:forEach></table></section><section class="panel"><h3>Women's Watches</h3><table class="table"><tr><th>Model</th><th>Stock</th></tr><c:forEach items="${listInventoryWomen}" var="i"><tr><td><c:out value="${i.modelName}"/></td><td>${i.stockQuantity}</td></tr></c:forEach></table></section></div><section class="panel"><h3>Inventory Details</h3><table class="table"><thead><tr><th>Category</th><th>Brand</th><th>Model</th><th>Product</th><th>Stock</th><th>Suppliers</th><th>Import Date</th><th>Import Price</th></tr></thead><tbody><c:forEach items="${listI}" var="i"><tr><td><c:out value="${i.categoryName}"/></td><td><c:out value="${i.brandName}"/></td><td><c:out value="${i.model}"/></td><td><c:out value="${i.fullName}"/></td><td>${i.stockQuantity}</td><td><c:out value="${i.supplierName}"/></td><td>${i.importDate}</td><td><fmt:formatNumber value="${i.productImportPrice}" pattern="#,##0"/> VND</td></tr></c:forEach></tbody></table></section></main></div></body></html>

