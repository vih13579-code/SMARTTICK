<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Product Management | SMARTTICK</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/smarttick.css"></head><body><div class="dashboard-shell"><jsp:include page="SidebarDashboard.jsp"/><main class="dash-main"><div class="section-head"><div><h2>Watch Management</h2><p class="section-sub">Manage CRUD, stock, status, and product images.</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/CreateProductServlet">+ Add Product</a></div><c:if test="${not empty sessionScope.success}"><div class="alert alert-success"><c:out value="${sessionScope.success}"/></div><c:remove var="success" scope="session"/></c:if><c:if test="${not empty sessionScope.error}"><div class="alert alert-danger"><c:out value="${sessionScope.error}"/></div><c:remove var="error" scope="session"/></c:if><form class="filter-panel" method="get" action="${pageContext.request.contextPath}/ProductListServlet"><div class="filter-grid" style="grid-template-columns:2fr 1fr 1fr 1fr auto"><input class="form-control" name="txt" value="<c:out value='${param.txt}'/>" placeholder="Search name or model"><select class="form-select" name="categoryId"><option value="">All Categories</option><c:forEach items="${categories}" var="c"><option value="${c.categoryId}" ${param.categoryId==c.categoryId?'selected':''}><c:out value="${c.name}"/></option></c:forEach></select><select class="form-select" name="sortBy"><option value="ProductID">Newest</option><option value="FullName">Name</option><option value="Price">Price</option><option value="Stock">Stock</option></select><select class="form-select" name="order"><option value="asc">Ascending</option><option value="desc">Descending</option></select><button class="btn btn-primary">Apply</button></div></form><div class="panel"><table class="table"><thead><tr><th>Image</th><th>Model</th><th>Product</th><th>Brand</th><th>Category</th><th>Price</th><th>Inventory</th><th>Status</th><th>Actions</th></tr></thead><tbody><c:forEach items="${products}" var="p"><tr><td><img class="table-image" src="${pageContext.request.contextPath}/product-images/${p.image}"></td><td><c:out value="${p.model}"/></td><td><c:out value="${p.fullName}"/></td><td><c:out value="${p.brandName}"/></td><td><c:out value="${p.categoryName}"/></td><td><fmt:formatNumber value="${p.price}" pattern="#,##0"/> VND</td><td>${p.stock}</td><td><span class="badge ${p.deleted==0?'badge-ok':'badge-off'}">${p.deleted==0?'On Sale':'Hidden'}</span></td><td><div class="table-actions"><a href="${pageContext.request.contextPath}/ProductListServlet?id=${p.productId}">View</a><a href="${pageContext.request.contextPath}/UpdateProductServlet?id=${p.productId}">Edit</a><c:choose><c:when test="${p.deleted==0}"><a class="danger" href="${pageContext.request.contextPath}/ProductListServlet?delete=${p.productId}" onclick="return confirm('Hide this product?')">Hide</a></c:when><c:otherwise><a href="${pageContext.request.contextPath}/ProductListServlet?restore=${p.productId}">Restore</a></c:otherwise></c:choose></div></td></tr></c:forEach></tbody></table></div></main></div></body></html>
