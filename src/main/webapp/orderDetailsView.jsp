<%@page contentType="text/html" pageEncoding="UTF-8" import="java.util.*,Models.*"%><%Order o=(Order)request.getAttribute("order");List<String> statuses=(List<String>)request.getAttribute("statuses");%><!doctype html><html><head><title>Chi tiet don - Staff</title><link rel="stylesheet" href="assets/css/app.css"></head><body><main class="container"><h1>Order #<%=o.getId()%></h1><p><%=o.getCustomerName()%> · <%=o.getCreatedAt()%> · <b><%=o.getStatus()%></b></p><table><tr><th>San pham</th><th>Gia</th><th>SL</th><th>Thanh tien</th></tr><%for(OrderDetail d:o.getDetails()){%><tr><td><%=d.getProductName()%></td><td><%=String.format("%,d",d.getUnitPrice())%></td><td><%=d.getQuantity()%></td><td><%=String.format("%,d",d.getSubtotal())%></td></tr><%}%></table><h2>Tong: <%=String.format("%,d VND",o.getTotal())%></h2><form method="post" action="UpdateOrderServlet"><input type="hidden" name="id" value="<%=o.getId()%>"><select name="status"><%for(String s:statuses){%><option <%=s.equals(o.getStatus())?"selected":""%>><%=s%></option><%}%></select><button>Update Order Status</button></form><p><a href="ViewOrderListServlet">← Danh sach don</a></p></main></body></html>
