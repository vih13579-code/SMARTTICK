{
  "info": {
    "_postman_id": "8c26e07d-98f6-4fb8-9911-8c3233e761fb",
    "name": "SMARTTICK VNPAY Sandbox",
    "description": "Requests for the SMARTTICK VNPAY Sandbox integration. No HashSecret is stored in this collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/SMARTTICK"
    },
    {
      "key": "orderId",
      "value": "1"
    },
    {
      "key": "jsessionId",
      "value": ""
    },
    {
      "key": "capturedIpnUrl",
      "value": "https://YOUR_HTTPS_DOMAIN/SMARTTICK/api/payments/vnpay/ipn?PASTE_SIGNED_QUERY_HERE"
    }
  ],
  "item": [
    {
      "name": "Create VNPAY payment URL",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          },
          {
            "key": "Cookie",
            "value": "JSESSIONID={{jsessionId}}"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "orderId",
              "value": "{{orderId}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/payments/vnpay/create",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments",
            "vnpay",
            "create"
          ]
        }
      }
    },
    {
      "name": "Get order payment status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Cookie",
            "value": "JSESSIONID={{jsessionId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/payments/order/status?orderId={{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "payments",
            "order",
            "status"
          ],
          "query": [
            {
              "key": "orderId",
              "value": "{{orderId}}"
            }
          ]
        }
      }
    },
    {
      "name": "Replay captured valid IPN",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{capturedIpnUrl}}",
        "description": "Paste the complete genuine signed Sandbox IPN URL into capturedIpnUrl. Replay it to verify the duplicate callback response without exposing the HashSecret."
      }
    }
  ]
}
